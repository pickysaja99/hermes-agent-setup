[Unit]
Description=Hermes anti-refusal guardrail proxy
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/.hermes/anti-refusal
ExecStart=/usr/bin/env python3 %h/.hermes/anti-refusal/proxy.py
Restart=on-failure
RestartSec=3
# Read the LightVela/router key from the hermes env without exporting it globally
EnvironmentFile=-%h/.hermes/.env
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
