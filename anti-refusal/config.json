{
  "port": 9200,
  "max_attempts": 16,
  "request_budget_s": 540,
  "upstream_timeout": 180,
  "upstream_connect_timeout": 30,
  "inject_light": true,
  "force_prefill": true,
  "host_aware_keys": true,
  "default_model": "glm-5.3-flash",
  "models": [
    "glm-5.3-flash",
    "deepseek-v4.1-flash",
    "minimax-m2.7",
    "mercury-3",
    "qwen3.8-27b-fp8",
    "nemotron-3-ultra"
  ],
  "upstreams": [
    {
      "name": "morku",
      "base": "https://api.morku.my.id/v1",
      "key_env": "HERMES_CUSTOM_API_MORKU_MY_ID_API_KEY"
    },
    {
      "name": "qzgo",
      "base": "https://qzgo.digtel.id/v1",
      "key_env": "HERMES_CUSTOM_QZGO_DIGTEL_ID_API_KEY"
    },
    {
      "name": "gonka",
      "base": "https://api.gonkarouter.io/v1",
      "key_env": "HERMES_CUSTOM_API_GONKAROUTER_IO_API_KEY"
    }
  ],
  "upstream_base_url": "https://api.morku.my.id/v1",
  "upstream_key_env": "HERMES_CUSTOM_API_MORKU_MY_ID_API_KEY"
}
